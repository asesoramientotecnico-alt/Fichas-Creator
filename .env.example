# Copiar a .env.local y completar. .env.local no se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Solo servidor. Saltea RLS. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Solo servidor. Nunca prefijar con NEXT_PUBLIC_ (CLAUDE.md §2).
ANTHROPIC_API_KEY=<anthropic api key>

# Opcional. Por omisión usa el modelo que fija §2 (claude-sonnet-4-6).
ANTHROPIC_MODEL=

# Conexión directa a Postgres (pooler). Solo para aplicar migraciones.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres
